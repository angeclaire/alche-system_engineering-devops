#!/usr/bin/env bash
# Configures Nginx to run as the "nginx" user and listen on port 8080

# Create the nginx user if it doesn't already exist
id -u nginx &>/dev/null || useradd nginx

# Force the top-level user directive to nginx, regardless of its current value
sed -i 's/^user .*;/user nginx;/' /etc/nginx/nginx.conf

# Change the listen directives from port 80 to port 8080
sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server ipv6only=on;/listen [::]:8080 default_server ipv6only=on;/' /etc/nginx/sites-available/default

# Fully restart nginx so it re-forks workers under the new user
pkill -9 nginx 2>/dev/null
/etc/init.d/nginx start
