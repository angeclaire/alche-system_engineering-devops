#!/usr/bin/env bash
# Configures Nginx to run as the nginx user, listening on all IPs on port 8080

# Stop anything already bound to the old config
pkill apache2 2>/dev/null
pkill nginx 2>/dev/null

# Run the worker/master as nginx, not root
sed -i 's/^#\?user .*/user nginx;/' /etc/nginx/nginx.conf

# Listen on 8080 instead of 80 (both IPv4 and IPv6 default_server lines)
sed -i 's/listen 80 default_server/listen 8080 default_server/' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server/listen [::]:8080 default_server/' /etc/nginx/sites-available/default

# The nginx user needs to own the runtime dirs it writes to
chown -R nginx:nginx /var/lib/nginx /var/log/nginx /var/run /run

# Start the master process itself as nginx
sudo -u nginx /usr/sbin/nginx
